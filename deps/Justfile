set dotenv-load
set quiet

geth := "just -f " + join(justfile_directory(), "geth.just")
optimism := "just -f " + join(justfile_directory(), "optimism.just")

fetch:
    {{geth}} fetch
    {{optimism}} fetch

build: fetch
    #!/usr/bin/env
    
    ({{geth}} fetch; {{geth}} build) &
    ({{optimism}} fetch; {{optimism}} build) &
    wait
